---
/*
  /lab/notion/ — the Notion surface in the palette comparison set.

  One surface (paper white, warm-grey ecru ramp, warm-tinted shadow, the 12/8
  radius ceiling), seven fixed blocks (K1–K7 from lab-editing-map.md §6),
  painted in Notion's tokens and sequenced in Notion's order:
  K4 K6 K2 K7 K1 K5 K3.

  This is the surface where soft card fills and the 12/8 radius ceiling read
  best: the reading blocks sit in soft warm-grey cards with a warm-tinted
  shadow over a paper-white page. No serif override — Notion keeps each block's
  assigned font on a neutral body, with Space Mono for accents. Radius stops at
  12px (cards) / 8px (buttons); over-rounding is what makes a premium site read
  as a toy.

  Own shell — no BaseLayout. Static. Content verbatim from technical-editing.md §5.
*/
import LabMenu from '../../components/LabMenu.astro';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>/lab/notion — warm-white card surface</title>
  <meta
    name="description"
    content="The Notion surface: paper white, warm-grey ecru ramp, soft card fills, warm-tinted shadow, and the 12/8 radius ceiling. Seven fixed editing blocks in Notion's order."
  />

  <!-- Fonts via Google Fonts. The six originals; neutral body + Space Mono accents. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cuprum:ital,wght@0,400;0,700;1,400;1,700&family=Nova+Square&family=Oxanium:wght@400;600;700&family=Roboto+Flex:opsz,wght@8..144,300;8..144,400;8..144,600&family=Space+Mono:ital,wght@0,400;0,700;1,400&family=Ubuntu+Condensed&display=swap"
    rel="stylesheet"
  />

  <style is:global>
    :root {
      /* Notion surface tokens (editing-choices-directory.md PART A) */
      --surface: #FFFFFF;        /* paper white page ground */
      --surface-lift: #F9F9F8;   /* warm-grey ramp, light end — peripheral */
      --surface-card: #F7F6F3;   /* soft warm-grey (ecru) card fill */
      --surface-deep: #F1F0EC;   /* card base nudged ~7% toward warm near-black #494744 — focal */
      --ink: #37352F;            /* warm near-black ink */
      --ink-soft: rgba(55, 53, 47, 0.66);
      --ink-mute: rgba(55, 53, 47, 0.52);
      --btn-bg: #37352F;         /* dark warm-near-black control (Notion's primary) */
      --btn-bg-hover: #262521;
      --rule: rgba(55, 53, 47, 0.09);
      /* Warm-tinted shadows — rgba(15,15,15,0.0x), never pure black, staying in
         chromatic agreement with the warm canvas. */
      --shadow-sm: 0 1px 2px rgba(15, 15, 15, 0.04);
      --shadow-md: 0 6px 20px rgba(15, 15, 15, 0.05);
    }

    * { box-sizing: border-box; }

    html { -webkit-text-size-adjust: 100%; }

    body {
      margin: 0;
      background: var(--surface);
      color: var(--ink);
      font-family: 'Roboto Flex', system-ui, sans-serif;
      font-size: 18px;
      line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    .page { display: block; }

    /* One block = one editing treatment. Page stays paper white; the block is
       the card. */
    .blk { padding: 3.5rem 1.5rem; }
    .col { max-width: 62ch; margin-inline: auto; }

    /* Soft warm-grey card — the Notion signature. 12px radius ceiling, warm
       shadow, near-invisible warm border. */
    .card {
      background: var(--surface-card);
      border: 1px solid var(--rule);
      border-radius: 12px;
      box-shadow: var(--shadow-sm), var(--shadow-md);
      padding: 2.5rem;
    }

    /* Soft focus-directing gradients (technical-editing.md §3), delta ≤ ~7% — a
       whisper. Notion tolerates a touch more soft fill than Mercury/Attio, but
       still quiet. */
    .grad-focus { background: linear-gradient(180deg, var(--surface-card) 0%, var(--surface-deep) 100%); }
    .grad-recede { background: linear-gradient(180deg, #FBFBFA 0%, var(--surface-card) 100%); }

    /* Captions: italic, muted, in the block's own font, ≤16. */
    .cap { font-size: 15px; line-height: 1.5; color: var(--ink-mute); margin-top: 1.75rem; }
    .cap em { font-style: italic; }

    .note { font-size: 16px; color: var(--ink-soft); }

    a { color: var(--ink); text-decoration-thickness: 1px; text-underline-offset: 2px; }
    a:hover { color: var(--ink-soft); }

    /* ---- K4 stat-dense (Space Mono figure + source/caveat) — Stripe ---- */
    .k4-eyebrow {
      font-family: 'Space Mono', ui-monospace, monospace;
      font-size: 14px;
      letter-spacing: 0.02em;
      color: var(--ink-soft);
      margin: 0 0 1.5rem;
    }
    .stat { padding-block: 1.25rem; border-top: 1px solid var(--rule); }
    .stat:first-of-type { border-top: none; padding-top: 0; }
    .fig {
      font-family: 'Space Mono', ui-monospace, monospace;
      font-size: 28px;
      line-height: 1.2;
      font-weight: 700;
      margin: 0 0 0.5rem;
    }
    .src { font-family: 'Roboto Flex', sans-serif; font-size: 18px; line-height: 1.6; margin: 0; }
    .k4-cap { font-family: 'Space Mono', ui-monospace, monospace; }

    /* ---- K6 sidenote (Cuprum italic head + Cuprum italic body + margin note) — Works in Progress ---- */
    .k6-head {
      font-family: 'Cuprum', sans-serif;
      font-style: italic;
      font-weight: 700;
      font-size: 28px;
      line-height: 1.2;
      margin: 0 0 1.5rem;
    }
    .k6-body {
      font-family: 'Cuprum', sans-serif;
      font-style: italic;
      font-size: 18px;
      line-height: 1.6;
      margin: 0;
    }
    .k6-wrap { display: grid; grid-template-columns: minmax(0, 62ch) 15rem; gap: 2.5rem; align-items: start; }
    .k6-side {
      font-family: 'Cuprum', sans-serif;
      font-size: 16px;
      line-height: 1.5;
      color: var(--ink-soft);
      padding-top: 0.4rem;
    }
    @media (max-width: 820px) {
      .k6-wrap { grid-template-columns: 1fr; }
      .k6-side { border-left: 2px solid var(--rule); padding-left: 1rem; }
    }
    .k6-cap { font-family: 'Cuprum', sans-serif; }

    /* ---- K2 rhythm list (Ubuntu Condensed head + Roboto Flex items) — Linear ---- */
    .k2-eyebrow {
      font-family: 'Roboto Flex', sans-serif;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.4px;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin: 0 0 0.75rem;
    }
    .k2-head {
      font-family: 'Ubuntu Condensed', sans-serif;
      font-size: 32px;
      line-height: 1.15;
      letter-spacing: -0.022em;
      margin: 0 0 1.75rem;
    }
    .k2-list { list-style: none; padding: 0; margin: 0; }
    .k2-list li {
      font-family: 'Roboto Flex', sans-serif;
      font-size: 18px;
      line-height: 1.6;
      padding-block: 1rem;
      border-top: 1px solid var(--rule);
    }
    .k2-list li b { font-weight: 600; }
    .k2-cap { font-family: 'Ubuntu Condensed', sans-serif; letter-spacing: 0.01em; }

    /* ---- K7 statement close (Nova Square head + Roboto Flex body) — Stripe Press ---- */
    .k7-head {
      font-family: 'Nova Square', system-ui, sans-serif;
      font-size: 36px;
      line-height: 1.15;
      letter-spacing: -0.01em;
      margin: 0 0 1.25rem;
    }
    .k7-body { font-family: 'Roboto Flex', sans-serif; font-size: 18px; line-height: 1.65; margin: 0; }
    .k7-body + .k7-body { margin-top: 1rem; }
    .k7-cap { font-family: 'Roboto Flex', sans-serif; }

    /* ---- K1 premise (prose) — Stripe Press ---- */
    .k1-eyebrow {
      font-family: 'Roboto Flex', sans-serif;
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin: 0 0 1rem;
    }
    .k1-body { font-family: 'Roboto Flex', sans-serif; font-size: 18px; line-height: 1.65; margin: 0; }
    .k1-cap { font-family: 'Roboto Flex', sans-serif; }

    /* ---- K5 bare frame (Oxanium head + neutral body + mono doc-excerpt) — Stripe ---- */
    .k5-head {
      font-family: 'Oxanium', system-ui, sans-serif;
      font-weight: 600;
      font-size: 28px;
      line-height: 1.2;
      margin: 0 0 1.25rem;
    }
    .k5-body { font-family: 'Roboto Flex', sans-serif; font-size: 18px; line-height: 1.6; margin: 0 0 1.75rem; }
    .bare { margin: 0; }
    .doc-excerpt {
      border: 1px solid var(--rule);
      border-radius: 12px;
      padding: 1.5rem;
      background: var(--surface-lift);
      font-family: 'Space Mono', ui-monospace, monospace;
      font-size: 16px;
      line-height: 1.7;
      color: var(--ink-soft);
      white-space: pre-wrap;
      overflow-x: auto;
    }
    .doc-excerpt .anno { color: var(--ink); }
    figcaption { margin-top: 1rem; }
    .k5-cap { font-family: 'Oxanium', sans-serif; }

    /* ---- K3 long-text list (Cuprum) + plain CTA — 37signals/Basecamp ---- */
    .k3-head {
      font-family: 'Cuprum', sans-serif;
      font-weight: 700;
      font-size: 30px;
      line-height: 1.2;
      margin: 0 0 1.5rem;
    }
    .k3-list { font-family: 'Cuprum', sans-serif; font-size: 19px; line-height: 1.6; list-style: none; padding: 0; margin: 0 0 2rem; }
    .k3-list li { margin: 0 0 1.15rem; }
    .k3-list b { font-weight: 700; }
    .cta { margin-top: 0.5rem; }
    /* One CTA. Notion's dark control; 8px button radius (the second rung of the
       ceiling). */
    .btn {
      display: inline-block;
      font-family: 'Roboto Flex', sans-serif;
      font-size: 18px;
      background: var(--btn-bg);
      color: #FBFBFA;
      padding: 0.7rem 1.35rem;
      border-radius: 8px;
      text-decoration: none;
      box-shadow: var(--shadow-sm);
    }
    .btn:hover { background: var(--btn-bg-hover); color: #FBFBFA; }
    .k3-cap { font-family: 'Cuprum', sans-serif; }
  </style>
</head>

<body>
  <LabMenu active="notion" />
  <main class="page">

    <!-- ============ K4 — block rhythm and sequencing (stat-dense) ============ -->
    <!-- template: stat-dense · treatment: Stripe -->
    <section class="blk">
      <div class="col">
        <div class="card">
          <p class="k4-eyebrow">// block rhythm and sequencing — big SaaS</p>
          <div class="stat">
            <div class="fig">Linear</div>
            <p class="src">take the spacing rhythm and the restraint, invert the palette. The lesson is vertical rhythm, and whitespace used structurally.</p>
          </div>
          <div class="stat">
            <div class="fig">Stripe</div>
            <p class="src">how to sequence dense information so density stops feeling heavy. Useful for your §5, where you have a statistic plus a source plus a caveat in one block.</p>
          </div>
          <p class="cap k4-cap"><em>Space Mono figure 28 + Roboto Flex source 18, eyebrow 14 note · 62ch · left · 1px rule between · soft warm-grey card r12 · 3.5rem:1.25rem — similar to Stripe.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K6 — the 2026 warning (sidenote) ============ -->
    <!-- template: sidenote · treatment: Works in Progress -->
    <section class="blk">
      <div class="col" style="max-width: 88ch;">
        <div class="card">
          <h2 class="k6-head">One warning about the 2026 consensus</h2>
          <div class="k6-wrap">
            <div>
              <p class="k6-body">Every roundup this year says the same three things: put the product in motion at the top, add micro-interactions, consider dark mode. Two of those are wrong for you. You have no product UI to demo, and dark mode fights the calm-default frame you decided to install. Your equivalent of the interactive product moment is a real teardown excerpt rendered as a document — styled like a page from the artifact the client would receive, monospace annotations and all.</p>
            </div>
            <aside class="k6-side">That is your hero image and your §7 proof in one object.</aside>
          </div>
          <p class="cap k6-cap"><em>Cuprum italic head 28 + Cuprum italic body 18/1.6 · 62ch main + 15rem margin note (Cuprum 16) · left · soft warm-grey card r12 · 3.5rem:1.15rem — similar to Works in Progress.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K2 — palette + surface (rhythm list) ============ -->
    <!-- template: rhythm-list · treatment: Linear -->
    <section class="blk">
      <div class="col">
        <div class="card">
          <p class="k2-eyebrow">Palette + surface</p>
          <h2 class="k2-head">The white-main systems worth copying wholesale</h2>
          <ul class="k2-list">
            <li><b>Mercury</b> — the reference for premium-restrained off-white. Near-invisible borders, almost no shadow, one accent used sparingly. Serious without being cold, which is your construction-buyer problem exactly.</li>
            <li><b>Anthropic</b> — warm ivory ground, serif headings, very low saturation. Closest live example of your §1 brief: calm enough to read as a default rather than a pitch.</li>
            <li><b>Attio</b> — white, precise, tight grid. Shows how far a single accent goes when everything else is neutral.</li>
            <li><b>Notion</b> — the smoothed-edges reference. Radius scale, soft card fills, warm white. Study it for where rounding stops; over-rounding is what makes a premium site read as a toy.</li>
          </ul>
          <p class="cap k2-cap"><em>Ubuntu Condensed head 32 (−.022em) + Roboto Flex items 18/1.6, tracked eyebrow +.4px · 62ch · left · 1px rule top per item · soft warm-grey card r12 · 3.5rem:1rem — similar to Linear.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K7 — harvest close (statement) ============ -->
    <!-- template: statement · treatment: Stripe Press -->
    <section class="blk">
      <div class="col">
        <div class="card grad-focus">
          <h1 class="k7-head">Five numbers and two fonts.</h1>
          <p class="k7-body">Open each of these, then write down only: the radius value, the body measure in characters, the border color and weight, the ratio between section padding and paragraph spacing, the type pairing. Five numbers and two fonts.</p>
          <p class="k7-body">That set, applied to any block library, gets you closer to a coherent site than any theme purchase will.</p>
          <p class="cap k7-cap"><em>Nova Square head 36 + Roboto Flex 18/1.65 · 62ch · left · focal warm-grey card, focus grad (≤7%) r12 · 3.5rem:1rem — similar to Stripe Press.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K1 — premise (prose) ============ -->
    <!-- template: prose · treatment: Stripe Press -->
    <section class="blk">
      <div class="col">
        <div class="card">
          <p class="k1-eyebrow">Premise</p>
          <p class="k1-body">Your premise holds. A live site is a better template source than a template marketplace, because you can read the decisions rather than inherit someone's content model. And the reskin is only about six variables: neutral ramp, one accent, radius scale, spacing scale, text measure, border weight. Fix those six and any layout you admire becomes yours.</p>
          <p class="cap k1-cap"><em>Roboto Flex eyebrow + Roboto Flex body 18/1.65 · 62ch · left · soft warm-grey card r12 · 3.5rem:1.15rem — similar to Stripe Press.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K5 — bare imagery (bare frame / doc-excerpt) ============ -->
    <!-- template: bare-frame · treatment: Stripe -->
    <section class="blk">
      <div class="col">
        <div class="card">
          <h2 class="k5-head">Bare imagery</h2>
          <p class="k5-body">Mercury, Ramp, and Arc all show images without device frames, drop shadows, or perspective tilt. That is the current premium signal, and it happens to be the only image treatment that fits you.</p>
          <figure class="bare">
            <div class="doc-excerpt"><span class="anno"># teardown — annotation layer</span>
&gt; hero      no device frame · no shadow · no tilt
&gt; measure   62ch
&gt; radius    12px card / 8px button
&gt; border    1px warm hairline
<span class="anno">&gt; note      the artifact IS the image</span></div>
            <figcaption class="note">Bare frame stands in for the image: a monospace document excerpt, no chrome.</figcaption>
          </figure>
          <p class="cap k5-cap"><em>Oxanium head 28 + Roboto Flex body 18/1.6 + Space Mono doc-excerpt 16 · 62ch · left · 1px framed excerpt r12 in soft warm-grey card · 3.5rem:1.75rem — similar to Stripe.</em></p>
        </div>
      </div>
    </section>

    <!-- ============ K3 — long-text handling (list) + CTA ============ -->
    <!-- template: prose-list · treatment: 37signals/Basecamp -->
    <section class="blk">
      <div class="col">
        <div class="card">
          <h2 class="k3-head">Long-text handling</h2>
          <ul class="k3-list">
            <li><b>Stripe Press</b> — book typography on the web. Measure control, no chrome, headings that hold their own without decoration.</li>
            <li><b>Works in Progress</b> — sidenotes, footnotes, sustained reading. Relevant to your Notion-docs layer and the sample teardowns.</li>
            <li><b>37signals / Basecamp</b> — plain speech, opinionated blocks, one CTA, active refusal of decoration. The nearest ethos match to your §6 and §9.</li>
          </ul>
          <!-- template: plain-cta · treatment: Basecamp -->
          <div class="cta">
            <a class="btn" href="/varpage/teardown/">Request a free teardown &rarr;</a>
          </div>
          <p class="cap k3-cap"><em>Cuprum head 30 + Cuprum body 19/1.6, one dark CTA (r8) · 62ch · left · soft warm-grey card r12 · 3.5rem:1.15rem — similar to 37signals / Basecamp.</em></p>
        </div>
      </div>
    </section>

  </main>
</body>
</html>
