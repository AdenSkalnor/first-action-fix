---
const title = "Submission received — First Action Fix";
const description = "Your teardown request has been received.";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:wght@500&family=JetBrains+Mono:wght@400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #0F172A;
        --bg: #F5F5F4;
        --rule: #D6D3D1;
        --muted: #57534E;
        --accent: #0F766E;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
      }

      .shell {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      header.site {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 2rem 2rem 0;
      }

      .logo {
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
      }
      .logo:hover { text-decoration: underline; }

      .top-contact {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--ink);
        text-decoration: none;
      }
      .top-contact:hover { text-decoration: underline; }

      main {
        flex: 1;
        opacity: 0;
        animation: fade 300ms ease-out forwards;
        padding: 0 2rem;
      }

      @keyframes fade {
        to { opacity: 1; }
      }

      .anchor {
        /* Asymmetric: content sits at 35% from top of viewport */
        padding-top: calc(35vh - 80px);
        max-width: 56ch;
        margin: 0 auto 0 max(2rem, 12vw);
        text-align: left;
      }

      h1 {
        font-family: 'Newsreader', Georgia, serif;
        font-weight: 500;
        font-size: 44px;
        line-height: 1.15;
        letter-spacing: -0.01em;
        color: var(--ink);
        margin: 0 0 1.75rem;
      }

      p.body {
        font-family: 'Inter', sans-serif;
        font-size: 18px;
        line-height: 1.6;
        color: var(--ink);
        margin: 0 0 1.25rem;
      }

      .links {
        margin-top: 3.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
      }

      .links a {
        font-family: 'JetBrains Mono', monospace;
        font-size: 13px;
        letter-spacing: 0.06em;
        color: var(--accent);
        text-decoration: none;
        text-transform: uppercase;
      }
      .links a:hover { text-decoration: underline; text-underline-offset: 4px; }

      footer.site {
        max-width: 1100px;
        margin: 6rem auto 0;
        padding: 2rem;
        border-top: 1px solid var(--rule);
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem;
        width: 100%;
      }
      footer.site a { color: var(--muted); }

      @media (max-width: 720px) {
        header.site { padding: 1.25rem 1.25rem 0; }
        main { padding: 0 1.25rem; }
        .anchor {
          padding-top: 18vh;
          margin: 0;
          max-width: 100%;
        }
        h1 { font-size: 32px; }
        p.body { font-size: 16.5px; }
        footer.site { padding: 1.5rem 1.25rem; }
      }
    </style>
  </head>
  <body>
    <div class="shell">
      <header class="site">
        <a class="logo" href="/varpage/">First Action Fix</a>
        <a class="top-contact" href="mailto:adennagleng@gmail.com">CONTACT</a>
      </header>

      <main>
        <div class="anchor">
          <h1>Submission received.</h1>
          <p class="body">You'll receive an acknowledgment within 24 hours, and the teardown within 48 hours of acceptance.</p>
          <p class="body">While you wait:</p>

          <div class="links">
            <a href="/varpage/eec/">How the EEC works &rarr;</a>
            <a href="/varpage/behavioral-triggers/">How behavioral triggers work &rarr;</a>
          </div>
        </div>
      </main>

      <footer class="site">
        <span>First Action Fix &copy; {year}</span>
        <span>
          <a href="mailto:adennagleng@gmail.com">adennagleng@gmail.com</a>
          &nbsp;&middot;&nbsp;
          <a href="/varpage/terms/">Terms</a>
          &nbsp;&middot;&nbsp;
          <a href="/varpage/privacy/">Privacy</a>
        </span>
      </footer>
    </div>
  </body>
</html>
