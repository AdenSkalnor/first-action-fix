---
const title = "Free teardown of your activation circuit — First Action Fix";
const description = "A 48-hour written teardown of where your trial activation circuit is leaking and what the missing sequence looks like.";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:wght@500&family=JetBrains+Mono:wght@400&family=Inter:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --ink: #0F172A;
        --bg: #F5F5F4;
        --rule: #D6D3D1;
        --muted: #57534E;
        --accent: #0F766E;
      }

      *, *::before, *::after { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: 'Inter', system-ui, sans-serif;
        font-weight: 400;
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      a { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; }
      a:hover { text-decoration: none; }

      .page {
        max-width: 640px;
        margin: 0 auto;
        padding: 2rem 1.5rem 4rem;
      }

      header.site {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-bottom: 3rem;
      }

      .logo {
        font-family: 'Inter', sans-serif;
        font-size: 15px;
        font-weight: 500;
        color: var(--ink);
        text-decoration: none;
      }
      .logo:hover { text-decoration: underline; }

      .top-contact {
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
        color: var(--ink);
        text-decoration: none;
      }
      .top-contact:hover { text-decoration: underline; }

      main {
        opacity: 0;
        animation: fade 300ms ease-out forwards;
      }
      @keyframes fade {
        to { opacity: 1; }
      }

      .eyebrow {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 1.25rem;
      }

      h1 {
        font-family: 'Newsreader', Georgia, serif;
        font-weight: 500;
        font-size: 44px;
        line-height: 1.15;
        margin: 0 0 1.25rem;
        color: var(--ink);
        letter-spacing: -0.01em;
      }

      .subhead {
        font-family: 'Inter', sans-serif;
        font-size: 17px;
        line-height: 1.55;
        color: var(--ink);
        margin: 0;
      }

      section {
        margin-top: 4rem;
      }

      h2.block-head {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin: 0 0 1.25rem;
      }

      p { margin: 0 0 1.1rem; }
      p:last-child { margin-bottom: 0; }

      h2.form-head {
        font-family: 'Newsreader', Georgia, serif;
        font-weight: 500;
        font-size: 28px;
        line-height: 1.2;
        margin: 0 0 2rem;
      }

      form .field {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        margin-bottom: 1.75rem;
      }

      form label {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 400;
        font-size: 11px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--ink);
      }

      form .optional {
        font-family: 'Inter', sans-serif;
        font-style: italic;
        text-transform: none;
        letter-spacing: 0;
        font-size: 12px;
        color: var(--muted);
        margin-left: 0.4rem;
      }

      form input[type="text"],
      form input[type="email"],
      form input[type="url"] {
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        color: var(--ink);
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--muted);
        padding: 8px 0;
        outline: none;
        border-radius: 0;
        width: 100%;
      }

      form input:focus {
        border-bottom: 2px solid var(--accent);
        padding-bottom: 7px;
      }

      form textarea {
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        color: var(--ink);
        background: transparent;
        border: 1px solid var(--muted);
        border-radius: 4px;
        padding: 12px;
        outline: none;
        min-height: 120px;
        width: 100%;
        resize: vertical;
      }

      form textarea:focus {
        border-color: var(--accent);
        border-width: 2px;
        padding: 11px;
      }

      .submit-wrap {
        margin-top: 3rem;
      }

      button[type="submit"] {
        font-family: 'Inter', sans-serif;
        font-weight: 500;
        font-size: 16px;
        color: #ffffff;
        background: var(--accent);
        border: none;
        border-radius: 4px;
        padding: 16px 32px;
        cursor: pointer;
      }
      button[type="submit"]:hover { opacity: 0.92; }

      .noscript-note {
        font-family: 'JetBrains Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.04em;
        color: var(--muted);
        margin-top: 1rem;
      }

      footer.site {
        margin-top: 6rem;
        padding-top: 2rem;
        border-top: 1px solid var(--rule);
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        color: var(--muted);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 0.75rem;
      }
      footer.site a { color: var(--muted); }

      @media (max-width: 600px) {
        h1 { font-size: 32px; }
        .page { padding: 1.5rem 1.25rem 3rem; }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="site">
        <a class="logo" href="/varpage/">First Action Fix</a>
        <a class="top-contact" href="mailto:adennagleng@gmail.com">CONTACT</a>
      </header>

      <main>
        <p class="eyebrow">FREE DIAGNOSTIC</p>
        <h1>Free teardown of your activation circuit.</h1>
        <p class="subhead">Forty-eight hours. Written deliverable. No call required.</p>

        <section>
          <h2 class="block-head">What it gives you</h2>
          <p>A written diagnostic of which circuits in your trial activation sequence are firing, which are dark, and where the largest single leak is happening.</p>
          <p>For each dark circuit, a description of what a fix would look like and a directional read on the lift available.</p>
          <p>A read on whether your tracking infrastructure can support a behavioral trigger system as it stands today, or whether foundation work is required first.</p>
          <p>The teardown is delivered as a document. You can act on it without booking another conversation.</p>
        </section>

        <section>
          <h2 class="block-head">What you provide</h2>
          <p>A link to your product or trial signup page.</p>
          <p>A snapshot of your current activation funnel: signup volume per month, current trial-to-paid conversion rate, and which onboarding/email tools you use.</p>
          <p>A copy of your current welcome sequence (forwarded screenshots are fine).</p>
          <p>If available, a sample of which steps users complete before converting versus where users drop. Approximate is enough.</p>
        </section>

        <section>
          <h2 class="block-head">Timeline</h2>
          <p>Submission acknowledged within 24 hours.</p>
          <p>Teardown delivered within 48 hours of submission acceptance.</p>
          <p>If your situation is outside the scope (B2C, sub-50 monthly signups, non-trial business model), the response will say so within 24 hours and point to a more appropriate resource.</p>
        </section>

        <section>
          <h2 class="form-head">Request a teardown</h2>
          <form
            action="mailto:adennagleng@gmail.com"
            method="post"
            enctype="text/plain"
            onsubmit="setTimeout(function(){ window.location.href = '/varpage/teardown/thank-you/'; }, 100); return true;"
          >
            <div class="field">
              <label for="name">Name</label>
              <input id="name" type="text" name="Name" autocomplete="name" />
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" type="email" name="Email" autocomplete="email" />
            </div>
            <div class="field">
              <label for="company">Company name</label>
              <input id="company" type="text" name="Company" autocomplete="organization" />
            </div>
            <div class="field">
              <label for="url">Product URL</label>
              <input id="url" type="url" name="Product URL" />
            </div>
            <div class="field">
              <label for="signups">Monthly trial signups</label>
              <input id="signups" type="text" name="Monthly trial signups" />
            </div>
            <div class="field">
              <label for="rate">Current trial-to-paid conversion rate</label>
              <input id="rate" type="text" name="Trial-to-paid rate" />
            </div>
            <div class="field">
              <label for="tool">Current email tool</label>
              <input id="tool" type="text" name="Email tool" />
            </div>
            <div class="field">
              <label for="notes">Anything else you want included<span class="optional">(optional)</span></label>
              <textarea id="notes" name="Notes"></textarea>
            </div>

            <div class="submit-wrap">
              <button type="submit">Request teardown &rarr;</button>
            </div>

            <noscript>
              <p class="noscript-note">Without JavaScript, your mail client opens directly without a redirect.</p>
            </noscript>
          </form>
        </section>
      </main>

      <footer class="site">
        <span>First Action Fix &copy; {year}</span>
        <span>
          <a href="mailto:adennagleng@gmail.com">adennagleng@gmail.com</a>
          &nbsp;&middot;&nbsp;
          <a href="/varpage/terms/">Terms</a>
          &nbsp;&middot;&nbsp;
          <a href="/varpage/privacy/">Privacy</a>
        </span>
      </footer>
    </div>
  </body>
</html>
