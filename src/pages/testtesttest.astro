    </div>
  </section>

</BaseLayout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

  .font-sample {
    margin-bottom: 4rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  .font-sample:last-child {
    border-bottom: none;
  }

  .font-sample__name {
    margin-bottom: 1.5rem;
    font-size: 1.5rem;
  }

  .font-sample__tag {
    display: inline-block;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    vertical-align: middle;
    margin-left: 0.5rem;
  }

  .font-sample__card {
    max-width: 500px;
  }

  .font-sample__card h3,
  .font-sample__card h4,
  .font-sample__card p {
    font-family: inherit;
  }

  .font-sample__body {
    max-width: 720px;
  }

  .font-sample__body h3,
  .font-sample__body p {
    font-family: inherit;
  }

  .font-sample__body p {
    color: var(--text-muted);
  }
</style>
