  .direct-variant .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .direct-variant .d-section {
    padding: 5.5rem 0;
    border-top: 1px solid var(--d-rule);
  }
  .direct-variant .d-section--alt {
    background: var(--d-bg-alt);
  }
  .direct-variant .d-section--cta {
    background: var(--d-bg-deep);
    color: #F2F3F5;
    border-top: 1px solid #1A1D24;
  }

