  <!-- ============================================================
       Page-local script: count-up animation for week numbers.
       Reuses the global IntersectionObserver pattern but watches
       only .d-timeline__num. Reduced-motion users get final value.
       ============================================================ -->
  <script is:inline>
    (() => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nums = document.querySelectorAll('.d-timeline__num');
      if (!nums.length) return;

      if (reduceMotion) {
        nums.forEach((el) => {
          const t = el.getAttribute('data-count') || el.textContent || '0';
          el.textContent = t;
        });
        return;
      }

      const animate = (el) => {
        const target = parseInt(el.getAttribute('data-count') || '0', 10);
        const duration = 600;
        const start = performance.now();
        const tick = (now) => {
          const p = Math.min(1, (now - start) / duration);
          // ease-out cubic
          const eased = 1 - Math.pow(1 - p, 3);
          el.textContent = String(Math.round(target * eased));
          if (p < 1) requestAnimationFrame(tick);
          else el.textContent = String(target);
        };
        requestAnimationFrame(tick);
      };

      const obs = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            animate(entry.target);
            obs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.4 });

      nums.forEach((el) => {
        el.textContent = '0';
        obs.observe(el);
      });
    })();
  </script>

</BaseLayout>

<!-- ============================================================
     STYLES
     All scoped under .direct-variant with is:global so we can
     override CSS variables for THIS PAGE ONLY without leaking.
     ============================================================ -->
<style is:global>
  /* Local theme override — applies only inside .direct-variant */
  .direct-variant {
    --d-bg:        #F7F7F5;
    --d-bg-alt:    #FFFFFF;
    --d-bg-deep:   #0F1115;
    --d-ink:       #14161A;
    --d-ink-soft:  #4B5260;
    --d-rule:      #E2E2DD;
    --d-accent:    #1F4ED8;
    --d-accent-2:  #0B2A8A;
    --d-warn:      #B85C00;
    --d-mono:      'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, monospace;
    --d-sans:      'IBM Plex Sans', 'Inter', system-ui, -apple-system, sans-serif;
    --d-body:      'Inter', system-ui, -apple-system, sans-serif;

    background: var(--d-bg);
    color: var(--d-ink);
    font-family: var(--d-body);
  }

  .direct-variant h1,
  .direct-variant h2,
  .direct-variant h3 {
    font-family: var(--d-sans);
    color: var(--d-ink);
    letter-spacing: -0.018em;
  }

