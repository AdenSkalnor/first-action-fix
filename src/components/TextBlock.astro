---
/*
  TextBlock — a titled section with body text.
  Use for any content section on any page.
  Props:
    heading  — section heading (H2)
    alt      — if true, uses alternate background color
*/
interface Props {
  heading?: string;
  alt?: boolean;
}

const { heading = '', alt = false } = Astro.props;
---

<section class={`section ${alt ? 'section--alt' : ''}`}>
  <div class="container reveal">
    {heading && <h2 class="mb-4">{heading}</h2>}
    <div class="text-block__body">
      <slot />
    </div>
  </div>
</section>

<style>
  .text-block__body {
    max-width: 720px;
  }
  .text-block__body :global(p + p) {
    margin-top: 1rem;
  }
</style>
